    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Periodogram",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "args": [
                "--mode=ebiten",
                "--wav-mode=static",
                "--wav=${workspaceFolder}/MSK144_wav/160915_113100.wav"
            ],
            "buildFlags": "-gcflags=all=\"-N -l\"",
            "showLog": false,
            "logOutput": "debuglineerr"
        }
    ]
}